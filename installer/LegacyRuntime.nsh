; Exact private runtime payload from the 1.1.0 installer. Preserve unrelated files.
!macro RemoveLegacyLanguage lang
  Delete "$INSTDIR\app\${lang}\Microsoft.VisualBasic.Forms.resources.dll"
  Delete "$INSTDIR\app\${lang}\PresentationCore.resources.dll"
  Delete "$INSTDIR\app\${lang}\PresentationFramework.resources.dll"
  Delete "$INSTDIR\app\${lang}\PresentationUI.resources.dll"
  Delete "$INSTDIR\app\${lang}\ReachFramework.resources.dll"
  Delete "$INSTDIR\app\${lang}\System.Windows.Controls.Ribbon.resources.dll"
  Delete "$INSTDIR\app\${lang}\System.Windows.Forms.Design.resources.dll"
  Delete "$INSTDIR\app\${lang}\System.Windows.Forms.Primitives.resources.dll"
  Delete "$INSTDIR\app\${lang}\System.Windows.Forms.resources.dll"
  Delete "$INSTDIR\app\${lang}\System.Windows.Input.Manipulations.resources.dll"
  Delete "$INSTDIR\app\${lang}\System.Xaml.resources.dll"
  Delete "$INSTDIR\app\${lang}\UIAutomationClient.resources.dll"
  Delete "$INSTDIR\app\${lang}\UIAutomationClientSideProviders.resources.dll"
  Delete "$INSTDIR\app\${lang}\UIAutomationProvider.resources.dll"
  Delete "$INSTDIR\app\${lang}\UIAutomationTypes.resources.dll"
  Delete "$INSTDIR\app\${lang}\WindowsBase.resources.dll"
  Delete "$INSTDIR\app\${lang}\WindowsFormsIntegration.resources.dll"
  RMDir "$INSTDIR\app\${lang}"
!macroend

